{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p public/static && cp -r static/. public/static/ && cp demo-preview.html bridge-preview.html login-preview.html welcome-preview.html public/ 2>/dev/null || true",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "{app.py,scout/**,content/**,templates/**,data/db/**}",
      "maxDuration": 60,
      "regions": ["sin1"]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/health", "schedule": "23 2 * * *" }
  ]
}
