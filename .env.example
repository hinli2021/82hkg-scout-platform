# ── Storage ──────────────────────────────────────────────────────────────────
# local  = JSON files in ./data/db  + photos in ./data/uploads   (zero setup)
# sheets = your Google spreadsheet IS the database, photos go to your Drive
#          正式上線請用 sheets：資料才不會因為執行個體回收而消失
DATA_DRIVER=local

# ── Google Sheets mode (DATA_DRIVER=sheets) ──────────────────────────────────
# Share the Sheet and the Drive folder with the service-account email
# (see docs/02-google-sheets-setup.md).
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# …or paste the whole JSON in one variable instead:
# GOOGLE_SERVICE_ACCOUNT_JSON={}

# ── App ──────────────────────────────────────────────────────────────────────
PORT=5001
HOST=0.0.0.0
SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECURE=false
DATA_DIR=./data

# 正式預設：示範帳戶與示範資料都關閉，第一次開啟會顯示「建立第一位領袖」。
# 想在開會時快速示範，才把這兩個設成 true（離線試玩檔與檢查腳本會自行設定）。
DEMO_LOGIN=false
SEED_DEMO=false
